{
  "name": "pricing-renderer",
  "version": "0.1.0",
  "description": "A framework-friendly, themeable renderer for Pricing2Yaml pricing models.",
  "type": "module",
  "license": "MIT",
  "author": "Francisco Javier Cavero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javiercavlop/pricing-renderer.git"
  },
  "homepage": "https://github.com/javiercavlop/pricing-renderer#readme",
  "bugs": {
    "url": "https://github.com/javiercavlop/pricing-renderer/issues"
  },
  "keywords": [
    "pricing",
    "pricing2yaml",
    "web-component",
    "react",
    "lit",
    "saas"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "customElements": "./custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./yaml": {
      "types": "./dist/yaml/index.d.ts",
      "default": "./dist/yaml/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./define": {
      "types": "./dist/element/define.d.ts",
      "default": "./dist/element/define.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./base.css": "./dist/styles/base.css",
    "./theme.css": "./dist/styles/theme.css",
    "./styles.css": "./dist/styles/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/element/define.js",
    "./dist/react/index.js",
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "react": "^19.2.8",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -b && node scripts/copy-styles.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "demo": "pnpm build && pnpm --filter pricing-renderer-demo dev",
    "demo:react": "pnpm build && pnpm --filter pricing-renderer-react-demo dev",
    "demo:next": "pnpm build && pnpm --filter pricing-renderer-next-demo dev",
    "package:check": "pnpm build && publint && attw --pack . --profile esm-only --entrypoints . ./yaml ./element ./define ./react",
    "release:check": "node scripts/check-release-ready.mjs",
    "release:registry-check": "node scripts/check-npm-version-available.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm package:check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
