{
  "schemaVersion": "1.0.0",
  "readme": "README.md",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "dist/element/pricing-renderer-element.js",
      "declarations": [
        {
          "kind": "class",
          "name": "PricingRendererElement",
          "customElement": true,
          "tagName": "pricing-renderer",
          "description": "A responsive, themeable renderer for Pricing2Yaml 3.x.",
          "members": [
            { "kind": "field", "name": "pricing", "type": { "text": "IPricingLike" } },
            { "kind": "field", "name": "yaml", "type": { "text": "string" } },
            { "kind": "field", "name": "src", "type": { "text": "string" }, "attribute": "src" },
            {
              "kind": "field",
              "name": "request",
              "type": { "text": "PricingRequestOptions" }
            },
            { "kind": "field", "name": "loadPricing", "type": { "text": "PricingLoader" } },
            {
              "kind": "field",
              "name": "normalizeOptions",
              "type": { "text": "NormalizePricingOptions" }
            },
            {
              "kind": "field",
              "name": "expressionOptions",
              "type": { "text": "ExpressionOptions" }
            },
            { "kind": "field", "name": "selection", "type": { "text": "PricingSelection" } },
            {
              "kind": "field",
              "name": "defaultSelection",
              "type": { "text": "Partial<PricingSelection>" }
            },
            {
              "kind": "field",
              "name": "currentSelection",
              "type": { "text": "Partial<PricingSelection> | undefined" },
              "description": "The customer's current contract. Marks the current plan and add-ons, and labels the other plans' calls to action as upgrades or downgrades. It does not change the selection in effect and emits no pricing-selection-change. The element keeps a deep copy."
            },
            {
              "kind": "field",
              "name": "pendingActionId",
              "type": { "text": "string | undefined" },
              "attribute": "pending-action-id",
              "description": "Action id of the call to action whose work the host is doing. That control shows a busy state, every plan call to action and the summary action get aria-disabled, and activating them dispatches no pricing-action."
            },
            {
              "kind": "field",
              "name": "presentation",
              "type": { "text": "PricingPresentation" }
            },
            {
              "kind": "field",
              "name": "locale",
              "type": { "text": "string" },
              "attribute": "locale"
            },
            {
              "kind": "field",
              "name": "pricingPath",
              "type": { "text": "string" },
              "attribute": "pricing-path"
            },
            {
              "kind": "field",
              "name": "selectionEnabled",
              "type": { "text": "boolean" }
            },
            { "kind": "field", "name": "ctaEnabled", "type": { "text": "boolean" } },
            {
              "kind": "field",
              "name": "variablesEnabled",
              "type": { "text": "boolean" }
            },
            { "kind": "field", "name": "messages", "type": { "text": "MessageCatalog" } },
            {
              "kind": "field",
              "name": "mode",
              "type": { "text": "\"commercial\" | \"catalog\"" },
              "attribute": "mode"
            },
            {
              "kind": "field",
              "name": "layout",
              "type": { "text": "\"auto\" | \"compact\" | \"table\"" },
              "attribute": "layout"
            },
            {
              "kind": "field",
              "name": "visibility",
              "type": { "text": "\"public-only\" | \"all\"" },
              "attribute": "visibility"
            },
            {
              "kind": "field",
              "name": "theme",
              "type": { "text": "\"light\" | \"dark\" | \"auto\"" },
              "attribute": "theme"
            },
            {
              "kind": "field",
              "name": "loadingLabel",
              "type": { "text": "string" },
              "attribute": "loading-label"
            },
            {
              "kind": "field",
              "name": "onlyDifferences",
              "type": { "text": "boolean | undefined" },
              "attribute": "only-differences",
              "description": "Initial state of the Only differences checkbox of the comparison toolbar. Absent is automatic (on when the pricing has more than 100 comparison rows, at least 2 plans and the toolbar is shown, otherwise off), present or any value except \"false\" is on, \"false\" is off."
            },
            {
              "kind": "field",
              "name": "toolbarThreshold",
              "type": { "text": "number" },
              "attribute": "toolbar-threshold",
              "description": "The toolbar is shown when the pricing has more than this many comparison rows (default 40). Invalid or negative values fall back to 40."
            },
            {
              "kind": "field",
              "name": "addOnFilterThreshold",
              "type": { "text": "number" },
              "attribute": "add-on-filter-threshold",
              "description": "The add-on grid switches to filter mode (search, counter and a cap of 8 initial cards, selected add-ons are never hidden) when the pricing has more add-ons than this (default 13). Invalid or negative values fall back to 13."
            },
            {
              "kind": "field",
              "name": "resolvedState",
              "type": { "text": "PricingSelectionChangeDetail | undefined" },
              "readonly": true,
              "description": "Detached snapshot of the selection in effect and its resolved pricing, or undefined while the element is not ready. It resolves the pricing on every read: read it on events, not in a render loop."
            },
            {
              "kind": "method",
              "name": "reload",
              "return": { "type": { "text": "Promise<void>" } }
            },
            {
              "kind": "method",
              "name": "applySelection",
              "parameters": [
                {
                  "name": "selection",
                  "type": { "text": "Partial<PricingSelection>" }
                }
              ],
              "return": { "type": { "text": "ApplySelectionResult" } },
              "description": "Validates the selection against the loaded pricing and replaces the internal selection. Omitted fields take the schema defaults. Emits no pricing-selection-change. Refused by result (applied: false) while the element is not ready or when the selection property is set."
            }
          ],
          "attributes": [
            { "name": "src", "fieldName": "src", "type": { "text": "string" } },
            { "name": "locale", "fieldName": "locale", "type": { "text": "string" } },
            { "name": "pricing-path", "fieldName": "pricingPath", "type": { "text": "string" } },
            {
              "name": "mode",
              "fieldName": "mode",
              "type": { "text": "\"commercial\" | \"catalog\"" }
            },
            {
              "name": "layout",
              "fieldName": "layout",
              "type": { "text": "\"auto\" | \"compact\" | \"table\"" }
            },
            {
              "name": "visibility",
              "fieldName": "visibility",
              "type": { "text": "\"public-only\" | \"all\"" }
            },
            {
              "name": "theme",
              "fieldName": "theme",
              "type": { "text": "\"light\" | \"dark\" | \"auto\"" }
            },
            { "name": "loading-label", "fieldName": "loadingLabel", "type": { "text": "string" } },
            {
              "name": "only-differences",
              "fieldName": "onlyDifferences",
              "type": { "text": "boolean | undefined" }
            },
            {
              "name": "toolbar-threshold",
              "fieldName": "toolbarThreshold",
              "type": { "text": "number" }
            },
            {
              "name": "add-on-filter-threshold",
              "fieldName": "addOnFilterThreshold",
              "type": { "text": "number" }
            },
            {
              "name": "pending-action-id",
              "fieldName": "pendingActionId",
              "type": { "text": "string | undefined" }
            }
          ],
          "events": [
            {
              "name": "pricing-ready",
              "type": { "text": "CustomEvent<PricingReadyDetail>" },
              "description": "Fired after a successful load. The detail has pricing, diagnostics, and the selection in effect and its resolved pricing as selection and resolved."
            },
            {
              "name": "pricing-selection-change",
              "type": { "text": "CustomEvent<PricingSelectionChangeDetail>" }
            },
            {
              "name": "pricing-action",
              "type": { "text": "CustomEvent<PricingActionDetail>" },
              "description": "Fired when a call to action is activated. While currentSelection names a plan of the pricing, the detail also has relation and source ('plan' or 'summary'). Cancelable; a canceled link does not navigate."
            },
            {
              "name": "pricing-diagnostic",
              "type": { "text": "CustomEvent<PricingDiagnosticDetail>" },
              "description": "Fired with the diagnostics of a load, after an applySelection call that returns diagnostics, including its PR_SELECTION_NOT_READY and PR_SELECTION_CONTROLLED refusals, and when currentSelection or the pricing changes and currentSelection has a plan or add-on id the pricing does not define (PR_CURRENT_SELECTION_UNKNOWN_PLAN, PR_CURRENT_SELECTION_UNKNOWN_ADDON). Check the diagnostic code before treating an error as a load failure."
            }
          ]
        }
      ]
    }
  ]
}
